# Clients read the process environment; they do not automatically load .env.
# Copy to .env, fill in only the settings you use, and export them through your
# approved runtime. Never commit .env. Verification needs none of these keys.

# Public configuration. Replace VAULT_ID with the reviewed deployment.
# Autonomous mode reads RPC, vault and expected chain from its public JSON file.
NEAR_RPC_URL=https://test.rpc.fastnear.com
VAULT_ID=
NEAR_CHAIN_ID=testnet
EXPECTED_CHAIN_ID=testnet

# Agent submission identity and public evidence output.
AGENT_ACCOUNT=
AGENT_SECRET_KEY=
AGENT_OUTBOX=./agent-outbox

# Keeper payer identity and public handoff output.
KEEPER_ACCOUNT=
KEEPER_SECRET_KEY=
KEEPER_OUTBOX=./keeper-outbox

# Optional relay JWT. Configure only for execution/publication that needs it.
# RELAY_AUTH=

# Optional model mode. MODEL_NAME must be admitted by the vault mandate.
# MODEL_ENDPOINT_URL=https://your-reviewed-provider.example/v1/chat/completions
# MODEL_NAME=
# MODEL_API_KEY=

# Optional pinned signature verification. Leave absent when unused; empty
# values are intentionally invalid. A pin is not proof of TEE/model origin.
# MODEL_SIGNATURE_URL=https://your-reviewed-provider.example/v1/signatures/
# MODEL_SIGNING_ADDRESS=0x...
# MODEL_SIGNATURE_REQUIRED=true
