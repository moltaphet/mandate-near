# Copy to .env and fill in. Never commit .env.
# None of these are needed for ./scripts/verify.sh.

# NEAR network: testnet | mainnet
NEAR_NETWORK=testnet
# Account that deploys/owns the vault
NEAR_ACCOUNT_ID=
# Vault contract account
VAULT_ACCOUNT_ID=

# NEAR Intents partner key (https://partners.near-intents.org)
INTENTS_API_KEY=

# NEAR AI Cloud key (https://cloud.near.ai)
NEARAI_API_KEY=

# OutLayer payment key, format owner:nonce:secret (https://app.outlayer.ai)
OUTLAYER_PAYMENT_KEY=
